#!/usr/bin/env bash
# Versioned pre-commit hook. Install with: scripts/install-hooks.sh
root=$(git rev-parse --show-toplevel)

# 1) no secrets or private data in the staged diff
"$root/scripts/check-secrets.sh" || exit 1

# 2) new commits must use the anonymous GitHub address
email=$(git var GIT_AUTHOR_IDENT | sed -E 's/.*<([^>]*)>.*/\1/')
case "$email" in
  *@users.noreply.github.com) ;;
  *)
    echo "BLOCKED: author email is '$email'. This public repo needs the GitHub noreply address."
    echo "Run: scripts/install-hooks.sh <id>+<user>@users.noreply.github.com"
    exit 1 ;;
esac
